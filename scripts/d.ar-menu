#!/usr/bin/env bash

set -ue

# TODO: help message
[ $# = 1 ] || exit 2

file=$(realpath "$1")
while true; do
  printf >&2 "File: %s\n" "$file"
  printf >&2 "(e)dit, e(x)tract, (l)ist, (q)uit: "

  read -r -n1 ch
  printf >&2 "\n"

  case "$ch" in
    e) "$EDITOR" "$file" ;;
    x)
      ext "$file"
      # TODO: pick the directory! I don't think `ext` supports that at the moment.
      # printf >&2 "Pick a directory!\n"
      # (
      #   dir=$(cd "$(dirname "$file")" && d.pick-directory)
      #   cd "$dir"
      #   ext "$file"
      # ) || {
      #   printf >&2 "An error ocurred; aborting...\n"
      #   continue
      # }
      ;;
    l) d.ar-view "$file" | less ;;
    q) exit ;;
    *)
      printf >&2 "Unknown key %q...\n" "$ch"
      ;;
  esac
  printf >&2 "\n"
done
