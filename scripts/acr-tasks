#!/usr/bin/env janet

(use dotf-acr)
(use dotf-cli)
(use dotf-utils)

(def arg-spec
  '[:description "utility to filter tasks list"

    :subcommands
    [{:name list :args ()}
     {:name pick :args ()}
     {:name pick-edit :args ()}]

    :options
    [{:name source :short -s :long --source
      :help "the source from where to pick the tasks: all (default), journal"
      :has-arg true}
     {:name important :short -i :long --important
      :help "only show important tasks"}
     {:name vim-quickfix :long --vim-quickfix
      :help "use vim-quickfix format for use in the wiki folder"}
     ]])

(defn main [& args]
  (def {:opts opts :subcmd subcmd}
    (parse-args ;arg-spec :in-args args))

  (def wiki-dir (getenv-or-die "ACR_WIKI_DIR"))
  (def note-pairs (acr-get-wiki-note-pairs wiki-dir))

  (defn parse-task [line lnum]
    (def p (acr-parse-task-line line))
    (unless (nil? p)
      {:prefix (p :prefix)
       :content (p :content)
       :lnum lnum}))

  (var important-filter (fn [&] true))
  (when (opts 'important)
    (defn func [t]
      (->> (t :content) (string/find "%important") nil? not))
    (set important-filter func))

  (defn add-line-numbers [base-lnum lines]
    (seq [[i x] :pairs lines]
      [(+ i base-lnum) x]))

  (defn parse-all-tasks [on-file-tasks]
    (each np note-pairs
      (def [id path] np)
      (def data (acr-slurp-parse path))
      (def base-lnum (data :body-start-lnum))

      (def tasks
        (->>
          (data :body)
          (string/split "\n")
          (add-line-numbers base-lnum)
          (map |(parse-task (in $ 1) (in $ 0)))
          (filter (complement nil?))
          (filter important-filter)))
      (on-file-tasks np tasks)))

  (defn pick-task []
    (def choices @[])
    (def paths @[])
    (def all-tasks @[])

    (parse-all-tasks
      (fn [[_ path] tasks]
        (array/concat all-tasks tasks)
        (array/concat choices (map |($ :content) tasks))
        (for _ 0 (length tasks) (array/push paths path))))

    (if-let [[idx _] (try-brief (fzagnostic choices :prompt "Task:"))]
      [(in paths idx) (in all-tasks idx)]))

  (case subcmd
    'list
    (parse-all-tasks
      (fn [[id _] tasks]
        (each t tasks
          (def t-text (string (t :prefix) " " (t :content)))
          (if (opts 'vim-quickfix)
            (print id ".acr:" (t :lnum) ":1:" t-text) # TODO: location!!
            (print id " " t-text)))))

    'pick
    (match (pick-task)
      nil (os/exit 1)
      [path _] (print path))

    'pick-edit
    (match (pick-task)
      nil (os/exit 1)
      [path task] (edit-file path :lnum (task :lnum) :replace true))

    (error "unreachable")))
