#!/usr/bin/env janet

(use dotf-utils)
(use dotf-acr)

(defn main [arg0 & args]
  (assert (empty? args))
  (def wiki-dir (assert (os/getenv "ACR_WIKI_DIR")))

  (defn get-title [[_ _ _ header]]
    (in header :title ""))

  (def projects
    (as->
      (acr-find-by-tag wiki-dir "project") .x
      (sort-by get-title .x)))
  (def n-active (length projects))
  (def n-frozen (length (acr-find-by-tag wiki-dir "project.frozen")))
  (def n-done (length (acr-find-by-tag wiki-dir "project.done")))
  (def n-discarded (length (acr-find-by-tag wiki-dir "project.discarded")))

  (print "%% vim: ft=acrylic")

  (printf
    "%d active projects, %d frozen, %d done, %d discarded"
    n-active n-frozen n-done n-discarded)
  (print)

  (defn is-low-priority [[_ _ tags _]]
    (truthy? (find |(= $ "low_priority") tags)))

  (defn is-long-term [[_ _ tags _]]
    (truthy? (find |(= $ "long_term") tags)))

  (def projects-hp @[])
  (def projects-lp @[])
  (def projects-lt @[])
  (each p projects
    (cond
      (is-low-priority p) (array/push projects-lp p)
      (is-long-term p) (array/push projects-lt p)
      (array/push projects-hp p)))

  (defn get-first-task [path]
    (def p (acr-slurp-parse path))
    (def body-lines (string/split "\n" (p :body))) # TODO: this can be faster if I don't read the entire body at once.
    (prompt 'blk
      (each x body-lines
        (when (def t (acr-parse-task-line x))
          (return 'blk t)))))

  (defn get-first-task-text [path]
    (if (def t (get-first-task path))
      (t :content)
      "(could not find any tasks)"))

  (each [id path tags header] projects-hp
    (print "- *" (header :title) "* (" (header :tags) ")")
    (print "  " (get-first-task-text path))
    (print))

  (print "--- LOW PRIORITY ---")
  (each [id path tags header] projects-lp
    (def title (in header :title "<NO TITLE>"))
    (print "  *" title "*: " (get-first-task-text path)))
  (print)

  (print "--- LONG TERM ---")
  (each [id path tags header] projects-lt
    (def title (in header :title "<NO TITLE>"))
    (print "  *" title "*: " (get-first-task-text path)))

  # TODO: list frozen as well?
  )
