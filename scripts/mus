#!/usr/bin/env janet

(use dotf-path)
(use dotf-cli)
(use dotf-utils)

(def TMPDIR (os/getenv "TMPDIR" "/tmp"))
(def HOME (-> (os/getenv "HOME") (assert "no HOME set..?")))
(def state-path (string/format "%s/mus.state" TMPDIR))

(defn shuffle
  "Shuffle an array."
  [arr &opt start end]

  (def i-start (or start 0))
  (def i-end (or end (length arr)))
  (loop [i :range [i-start i-end]]
    (def j (-> (math/random) (* (- i-end i-start 1)) (math/round) (+ i-start)))
    (def tmp (in arr i))
    (set (arr i) (in arr j))
    (set (arr j) tmp)))

(def get-ext-kind
  (do
    (def music-exts
      (make-set ["mp3" "wav" "midi" "ogg" "mus" "m4a" "opus" "flac" "ogx"]))
    (def image-exts
      (make-set ["png" "jpg" "jpeg"]))

    (fn get-ext-kind [ext]
      (cond
        (in music-exts ext) :music
        (in image-exts ext) :image
        :unknown))
    ))

(defmacro with-file [head & body]
  (with-syms [mode-sym]
    (def [file-sym path mode] head)
    ~(let [,mode-sym (keyword ,mode :n)
           ,file-sym (file/open ,path ,mode-sym)]
       (defer (:close ,file-sym)
         ,;body))))

(defn file-get-lines [path]
  (with-file [file path :r]
    (seq [line :in (file/lines file)]
      line)))

(defn load-state []
  (defn default-result []
    @{:index 0 :queue @[]})

  (if (path/exists? state-path)
    (let [contents (file-get-lines state-path)]
      (if (empty? contents)
        (default-result)
        (let
          [index (-> (in contents 0) (string/trim) (scan-number))
           queue (as-> contents .x (array/slice .x 1) (map string/trim .x))]
          @{:index index :queue queue})))
    (default-result)))

(defn save-state [state]
  (with-file [file state-path :w]
    (:write file (string/format "%d\n" (in state :index)))
    (each p (in state :queue)
      (:write file (string p "\n")))))

(defmacro with-state
  "Runs `body` with the state assigned to `cap`. By the end of the scope, if the state object has a truthy :write field, the state is saved."
  [cap & body]

  ~(with-lock state-path
     (let [,cap (load-state)]
       (defer
         (when (in ,cap :write)
           (save-state ,cap))
         ,;body))))

(def arg-spec
  '(:description "mpv-based music queue manager and player"
    :subcommands
    ({:name add :args () :rest songs
      :help "Add one or more songs to the end of the queue"}
     {:name clear :help "Clear the queue"}
     {:name current :help "Get the song at the front of the queue"}
     {:name edit :help "Edit the queue file"}
     {:name queue :help "Show the queue"}
     {:name shuffle :help "Shuffle the songs after the current one in the queue"}
     {:name play :help "Play the songs in the queue"}

     # TODO: whoops! I think we do need optional arguments.
     {:name next :rest amount :help "Go forwards in the queue by AMOUNT (defaults to 1)"}
     {:name prev :rest amount :help "Go backwards in the queue by AMOUNT (defaults to 1)"}
     )

    :options
    ({:name skip-dirs :short -D :long --skip-dirs :help "Ignore directories when adding files to the queue"})
    ))

(var *skip-dirs* false)
(var *editor* "vi")

(defn add-song [state fname]
  (assert
    (path/exists? fname)
    (string/format "file %s does not exist" fname))

  (if (path/is-dir? fname)
    (if *skip-dirs*
      (eprintf "warning: skipping directory %s" fname)
      (each sub (os/dir fname)
        (add-song state (string fname "/" sub))))
    (let [real (os/realpath fname)
          ext (path/extension real)]
      (case (get-ext-kind ext)
        :music (array/push (in state :queue) real)
        :image nil # do nothing

        :unknown
        (print "warning: skipping " fname " "
               (if (nil? ext)
                 "(no extension)"
                 (string "(unsupported extension " ext ")")))))))

(defn main [& raw-args]
  (def {:subcmd subcmd :args args :opts opts}
    (parse-args :in-args raw-args ;arg-spec))

  (when (def v (in opts 'skip-dirs))
    (set *skip-dirs* true))

  (when (def v (os/getenv "EDITOR"))
    (set *editor* v))

  (defn parse-amount []
    (def am (in args 'amount))
    (if (empty? am) 1 (-> am first scan-number math/floor)))

  (case subcmd
    'add
    (with-state state
      (each arg (in args 'songs)
        (if (= arg "-")
          (while (def fname (:read stdin :line))
            (add-song state (string/trim fname)))
          (add-song state arg)))
      (set (state :write) true))

    'clear
    (with-state state
      (set (state :index) 0)
      (-> (state :queue) (array/clear))
      (set (state :write) true))

    'current
    (with-state state
      (def {:index index :queue queue} state)
      (if (< index (length queue))
        (printf "%d %s" (inc index) (in queue index))
        (die 1 "no more songs to play")))

    'edit
    (with-lock state-path
      (os/execute [*editor* state-path] :p))

    'queue
    (with-state state
      (loop [:let [index (in state :index)
                   queue (in state :queue)]
             [i path] :pairs queue]
        (def final-path (path/basename path))
        (def prefix
          (cond
            (< i index) "  "
            (= i index) "* "
            (> i index) "- "))
        (print prefix final-path)))

    'shuffle
    (with-state state
      (def {:index index :queue queue} state)
      (if (< (+ index 1) (length queue))
        (shuffle queue (+ index 1))
        (eprintf "no elements to shuffle."))
      (set (state :write) true))

    'next
    (with-state state
      (def amount (parse-amount))
      (set (state :index) (-> state (in :index) (+ amount)))
      (set (state :write) true))

    'prev
    (with-state state
      (def amount (parse-amount))
      (set (state :index) (-> state (in :index) (- amount) (max 0)))
      (set (state :write) true))

    'play
    (do
      (defn get-queue-state []
        (with-state {:queue q :index i}
          {:index i
           :queue q
           :cur-song (get q i)}))

      (defn the-loop []
        (def
          {:index index
           :queue queue
           :cur-song cur-song}
          (get-queue-state))

        (when (nil? cur-song)
          (eprintf "no more songs to play.")
          (break))

        (eprintf "(%d of %d) playing %s" (inc index) (length queue) (path/basename cur-song))
        (eprintf "full path: %s" cur-song)

        (os/execute ["mpv" "--no-video" cur-song] :p)
        (eprintf "\n")

        (with-state state
          (def
            {:index index
             :queue queue}
            state)
          (def cur-song-2 (get queue index))
          (if (= cur-song cur-song-2)
            (do
              (set (state :index) (inc index))
              (set (state :write) true))
            (eprintf "warning: current song isn't what I thought it was. I'm lost.")))
        (the-loop))

      (the-loop))

    (-> "what? what command is %q" (string/format subcmd) (error))))
