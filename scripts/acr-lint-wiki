#!/usr/bin/env janet

(use dotf-utils)
(use dotf-acr)

(defn main [arg0 & args]
  (assert (empty? args))
  (def wiki-dir (assert (os/getenv "ACR_WIKI_DIR")))

  (each [id path] (acr-get-wiki-note-pairs wiki-dir)
    (def res (run< ["acr2html" "-b" "debug" path] {:out true :err true}))
    (unless (zero? (res :code))
      (print id " ============")
      (print (res :err)))))
