#!/usr/bin/env sh

set -ue
exists() { command -v "$1" >/dev/null 2>/dev/null; }

tmp=$(mktemp -d)
_cleanup() {
  [ -d "$tmp" ] && rm -r "$tmp"
  return 0
}
trap '_cleanup' EXIT

scriptPath=~/.local/bin

cd "$DOTFILES/compiled"

# if exists ldc; then LDC=ldc
# elif exists ldc2; then LDC=ldc2
# else
#   printf >&2 "Could not figure out LDC...\n"
#   exit 1
# fi

# cd "$DOTFILES/compiled"
# "$LDC" acr_list_titles.d --od=build/ --of=build/acr-list-titles
# cp build/acr-list-titles -t ~/.local/bin

isAgeLeq() {
  m1=$(stat -c '%Y' "$1")
  m2=$(stat -c '%Y' "$2")
  [ "$m1" -le "$m2" ]
}

nimComp() {
  if [ $# != 3 ]; then
    printf >&2 "%s: bad args\n" "$0"
    return 2
  fi

  src=$1
  destDir=$2
  destName=$3
  destPath="$2/$3"

  if ! isAgeLeq "$src" "$destPath"; then
    nim --out:"$destName" --outdir:"$tmp" compile "$src"
    mv "$tmp/$destName" "$destPath"
  fi
}

# single-file nim programs
nimComp dotcfg.nim ~/.local/bin dotcfg
nimComp mus2.nim ~/.local/bin mus2
