#!/usr/bin/env sh

set -ue
progname=$(basename "$0")

exists() { command -v "$1" >/dev/null 2>/dev/null; }

showHelp() {
  cat >&2 <<EOF
$progname: utility to control screen brightness.

Usage: $progname { get | set <VALUE> | mod <AMOUNT> }
  VALUE has to be a positive integer.
  AMOUNT has to be a signed integer, with + or - explicitly as the signal.
EOF
  exit 2
}

validateValue() {
  if printf "%s" "$1" | grep -qv '^[0-9]\+\(\.[0-9]\+\)\?$'; then
    printf >&2 "not a valid value: %s\n" "$1"
    exit 2
  fi
}

validateAmount() {
  if printf "%s" "$1" | grep -qv '^[-+][0-9]\+\(\.[0-9]\+\)\?$'; then
    printf >&2 "not a valid amount: %s\n" "$1"
    exit 2
  fi
}

addAndClamp() {
  [ $# = 3 ] || exit 2
  awk -v x="$1" -v lower="$2" -v upper="$3" '{
    $0 = $0 + x;
    $0 = ($0 < lower) ? lower : $0;
    $0 = (upper < $0) ? upper : $0;
    print $0;
    exit;
  }'
}

if exists ddcutil && ddcutil --skip-ddc-checks detect | grep -q '^Display'; then
  impl_get() {
    ddcutil --skip-ddc-checks getvcp 16 --brief | awk '{
      split($0, arr, " ");
      cur = arr[4];
      max = arr[5];
      print 100 * (cur / max);
      exit;
    }'
  }
  _setBrightness() {
    ddcutil --skip-ddc-checks setvcp 16 "$1" 18 "$1" 1a "$1"
  }
  impl_set() {
    cur=$(printf "%s\n" "$1" | addAndClamp 0 1 100)
    _setBrightness "$cur"
  }
  impl_mod() {
    cur=$(impl_get | addAndClamp "$1" 1 100)
    _setBrightness "$cur"
  }
elif exists brightnessctl; then
  impl_get() {
    awk -v v="$(brightnessctl g)" -v m="$(brightnessctl m)" \
      'BEGIN { print v / m * 100; }'
  }
  impl_set() {
    real=$(awk -v v="$1" -v m="$(brightnessctl m)" 'BEGIN { print v * m / 100; }')
    brightnessctl s "$real"
  }
  impl_mod() {
    cur=$(impl_get | addAndClamp "$1" 1 100)
    impl_set "$cur"
  }
elif exists light; then
  cmd() { light -s "sysfs/backlight/auto" -v1 "$@"; }
  impl_get() { cmd; }
  impl_set() {
    cur=$(printf "%s\n" "$1" | addAndClamp 0 1 100)
    cmd -S "$cur"
  }
  impl_mod() {
    cur=$(impl_get | addAndClamp "$1" 1 100)
    cmd -S "$cur"
  }
elif [ "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && exists xbacklight; then
  impl_get() { xbacklight -get; }
  impl_set() {
    cur=$(echo "$1" | addAndClamp 0 0.5 100)
    xbacklight -set "$cur"
  }
  impl_mod() {
    cur=$(impl_get | addAndClamp "$1" 0.5 100)
    xbacklight -set "$cur"
  }
else
  printf >&2 "could not find valid backend\n"
  exit 1
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  showHelp
fi

case "$1" in
  set)
    [ $# = 2 ] || showHelp
    validateValue "$2"
    impl_set "$2"
    ;;
  mod)
    [ $# = 2 ] || showHelp
    validateAmount "$2"
    impl_mod "$2"
    ;;
  get)
    [ $# = 1 ] || showHelp
    impl_get
    ;;
  *) showHelp ;;
esac
