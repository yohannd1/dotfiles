#!/usr/bin/env janet

(use dotf-path)
(use dotf-utils)
(use dotf-acr)

(defn show-help []
  (def progname (-> (dyn *args*) (first) (path/basename)))
  (eprintf "Usage: %s <TAG>" progname)
  (os/exit 2))

(defn main [arg0 & args]
  (when (not= (length args) 1)
    (show-help))

  (def wiki-dir (getenv-or-die "ACR_WIKI_DIR"))
  (def [tag] args)

  (each [id path _ header] (acr-find-by-tag wiki-dir tag)
    (print id " " (in header :title "<NO TITLE>"))))
